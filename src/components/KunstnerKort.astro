---
const {kunstner} = Astro.props;
import '../styles/global.css';
--- 
<article><img src={`https://febilgfghfuozaigajsb.supabase.co/storage/v1/object/public/HoestMoenBilleder/${kunstner.billede}`} alt={kunstner.kunstnernavn}>
    <h2>{kunstner.kunstnernavn}</h2>
<!-- <p>{kunstner.beskrivelse}</p> -->

</article>

<style>
    article{
        width: 200px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        text-align: center;
        gap: 20px;
        background-color: var(--accent);
        color: var(--buttonTextColor);
    }
    img{
        max-width: 100%;
        height: auto;
    }