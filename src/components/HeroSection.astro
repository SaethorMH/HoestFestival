---
const {imgURL, menuSide} = Astro.props;
---
<div class="heroContainer">
    <div class="hero">
    <nav>
        <a href="/program" id="program" style={menuSide === 'program' ? 'transform:scale(1.2); pointer-events:none;' : ''}>Programet</a>
        <a href="/pladsen" id="pladsen" style={menuSide === 'pladsen' ? 'transform:scale(1.2); pointer-events:none;' : ''}>Pladsen</a>
        <a href="/arkiv" id="arkiv" style={menuSide === 'arkiv' ? 'transform:scale(1.2); pointer-events:none;' : ''}>Arkiv</a>
        <a href="/om" id="om" style={menuSide === 'om' ? 'transform:scale(1.2); pointer-events:none;' : ''}>Om os</a>
    </nav>
    <div id="heroImage">
<img src={imgURL} alt="HeroBillede">
</div>
<img src="/images/bakke2.svg" alt="Bakke 2" class="bakke" style="margin-top: 400px;">

<img src="/images/bakke1.svg" alt="Bakke 1" class="bakke">
<img src="/images/bakke3.svg" alt="Bakke 3" class="bakke">
<img src="/images/sol.svg" alt="solen" id="sol">

</div>
</div>

<style> 
.heroContainer{
    width: 100%;
    height: 100vh;
    overflow-y: hidden;
}
nav{
    margin: 5rem;
    display: flex;
    flex-direction: column;
    grid-column: 1/2;
    grid-row:1/2 ;
    place-self: start;
}
a{
    margin-top: 2rem;
    text-decoration: none;
    color: var(--black);
    font-size: 48px;
transition: 0.1s;
}
a:hover{
    transform: scale(1.1);
}
    .hero{
        display:grid;
        grid-template-columns: 1fr 1fr 1fr;
        align-items: center;
        width: 100%;
    }
    .hero .bakke{ 
        
        grid-column: 1/-1;
        grid-row: 1/2;
        max-width: 100%;
        pointer-events: none;
    } 
    #sol{
        grid-column: 3/4;
        grid-row: 1/2;
        place-self: center ;
        margin-top:-10rem;
        width: 250px;
    }
    #heroImage{
        background-color: black;
        
        width: 100%;
        height: 100%;
        grid-column: 2/-1;
        grid-row: 1/2;
    }
    @media  {
        
    }
    
    
   
</style>
