---
//@ts-nocheck
import ArkivTilbageblik from "../components/ArkivTilbageblik.astro";
import Layout from "../layout/Layout.astro";
import '../styles/global.css';

const url =`${import.meta.env.PUBLIC_SUPABASE_URL}/rest/v1/Kunstnere?select=*&limit=5&order=id`;
const apiKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;

const options = {
  headers: {
    apikey: apiKey,
  },
};

const data = await fetch(url, options)
  .then((res) => res.json());

console.log(data);

---

    <Layout title="Arkiv" menuSide="arkiv" imgURL="/images/arkiv.webp">
        <h1>Arkiv - Et varmt tilbageblik</h1>
        <section id="dropdown">
            {data.map((kunstner) => <ArkivTilbageblik kunstner={kunstner} />)}
        </section>
        <section id="genveje">

        </section>
    </Layout>

<style>
    h1{
        padding: 0 20px 20px 20px;
        font-size: 3.5rem;
    }
    #genveje{
        background-color: var(--primaryDarker);
    }