---
//@ts-nocheck
import KunstnerKort from "../components/KunstnerKort.astro";
import Layout from "../layout/Layout.astro";


const url =`${import.meta.env.PUBLIC_SUPABASE_URL}/rest/v1/Kunstnere?select=*`;
const apiKey = import.meta.env.PUBLIC_SUPABASE_PUBLISHABLE_KEY;
const options = {
  headers: {
    apikey: apiKey,
  },
};

const data = await fetch(url, options)
  .then((res) => res.json());
  


console.log(data)
---

	
	<Layout title="Forside">
<h1>Dette er forsiden</h1>
{data.map((kunstner) => <KunstnerKort kunstner={kunstner} />)}

	</Layout>

